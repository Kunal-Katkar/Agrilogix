# Copy this file to .env and fill it in. Never commit .env.
# MongoDB Atlas connection string: Atlas > Database > Connect > Drivers.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=agrilogix

# Registration OTP emails (server/index.mjs). Gmail example: enable 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and use it as SMTP_PASS (not your normal password).
# Leave these unset to print OTPs in the server console instead (development only).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="AgriLogiX <your-address@gmail.com>"
